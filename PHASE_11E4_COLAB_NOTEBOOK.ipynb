## 6. Train Model

```python
!python /content/openwakeword/openwakeword/train.py \
    --training_config /content/my_model.yaml \
    --train_model 2>&1 | tee /content/train.log

# Verify model exists
import os
model_path = "/content/veronica_wake_model.onnx"
if os.path.exists(model_path):
    size = os.path.getsize(model_path)
    print(f"✓ Model created: {model_path} ({size} bytes)")
    if size == 0:
        raise RuntimeError("Model file is empty")
else:
    print(f"❌ Model file {model_path} not found")
    raise RuntimeError("Model training failed")
```

## 7. ONNX Validation

```python
import onnx
import onnxruntime as ort

print("\nValidating ONNX model...")
try:
    model = onnx.load(model_path)
    onnx.checker.check_model(model)
    print("✓ ONNX model is valid")

    # Test inference
    sess = ort.InferenceSession(model_path)
    print(f"✓ onnxruntime can load model (session created)")

    # Check input/output shapes
    input_name = sess.get_inputs()[0].name
    output_name = sess.get_outputs()[0].name
    input_shape = sess.get_inputs()[0].shape
    output_shape = sess.get_outputs()[0].shape
    print(f"  Input shape: {input_shape}")
    print(f"  Output shape: {output_shape}")

except Exception as e:
    print(f"❌ ONNX validation failed: {str(e)}")
    raise
```

