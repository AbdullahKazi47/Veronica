    "background_paths_duplication_rate": [1],
    "feature_data_files": {
        "positive": "/content/positive_features_train.npy",
        "adversarial_negative": "/content/negative_features_train.npy",
        "false_positive_validation_data": "/content/false_positive_val.npy"
    }
}

# Create required directories
os.makedirs("/content/openwakeword/openwakeword/resources/rir", exist_ok=True)
os.makedirs("/content/openwakeword/openwakeword/resources/background_noise", exist_ok=True)

# Save config
with open("/content/my_model.yaml", "w") as f:
    yaml.dump(config, f)
print("✓ Configuration saved to /content/my_model.yaml")
```

## 4. Generate Clips

```python
!python /content/openwakeword/openwakeword/train.py \
    --training_config /content/my_model.yaml \
    --generate_clips 2>&1 | tee /content/generate_clips.log

# Verify clip counts
import os
clip_dirs = [
    "/content/openwakeword/openwakeword/resources/positive_train",
    "/content/openwakeword/openwakeword/resources/positive_test",
    "/content/openwakeword/openwakeword/resources/negative_train",
    "/content/openwakeword/openwakeword/resources/negative_test"
]

print("\nClip directory verification:")
for d in clip_dirs:
    if os.path.exists(d):
        count = len(os.listdir(d)) if os.path.isdir(d) else 0
        print(f"  {d}: {count} files")
        if count < 50:
            print(f"  ⚠️  WARNING: {d} has few files ({count}) - may be incomplete")
            raise RuntimeError(f"Insufficient files in {d}: {count}")
    else:
        print(f"  ❌ {d} does not exist")
        raise RuntimeError(f"Required clip directory {d} missing")
```

