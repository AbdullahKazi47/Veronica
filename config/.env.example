# Copy this file to config/.env and fill in ONLY what you actually intend to use.
# VERONICA runs fully without any of these (local Ollama + free weather + free TTS/STT).

# Only needed if config.yaml sets llm.provider: openai_compatible
# (e.g. an OpenRouter key, or any OpenAI-compatible endpoint's key)
# VERONICA_LLM_API_KEY=

# Not used by default (weather_tools.py uses the free, keyless Open-Meteo API instead),
# kept here as a documented extension point if you'd rather use OpenWeatherMap.
# OPENWEATHER_API_KEY=

# Not used by any built-in tool yet; reserved for a future higher-quality web_search tool.
# SERPAPI_API_KEY=
